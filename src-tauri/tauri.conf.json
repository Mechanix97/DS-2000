{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.tauri.ds2000",
  "productName": "DS2000",
  "version": "0.1.1",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "frontend/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "DS2000",
        "width": 800,
        "height": 600,
        "visible": true
      }
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "system-tray": {}
  },
  "bundle": {
    "icon": [
      "icons/ds2000-logo.ico"
    ],
    "targets": [
      "msi"
    ],
    "windows": {
      "wix": {
        "language": "es-ES"
      }
    },
    "publisher": "Mechardo Labs"
  }
}
